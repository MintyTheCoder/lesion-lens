# Copy to .env and fill in. Never commit .env.

# --- Roboflow (teammate 2 provides after training) ---
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=workspace/project/1        # from the Roboflow "Deploy" tab
ROBOFLOW_API_URL=https://serverless.roboflow.com

# --- Gemini (MLH: Best Use of Gemini API) ---
GEMINI_API_KEY=

# --- MongoDB Atlas (MLH: Best Use of MongoDB Atlas) ---
MONGODB_URI=
MONGODB_DB=ms_lesion

# --- Dev switches ---
# 1 = /analyze returns backend/app/fixtures/mock_analysis.json without calling Roboflow.
# Use this for frontend work before the model exists.
USE_MOCK_INFERENCE=1
